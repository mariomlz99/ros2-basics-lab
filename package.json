{
  "name": "ros2-basics-lab",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node scripts/installation-assets.mjs --check && node --test tests/*.test.js",
    "dev": "node scripts/bundle.mjs && node scripts/serve.mjs",
    "build": "node scripts/bundle.mjs && node scripts/build.mjs",
    "test:browser": "node scripts/browser.mjs",
    "preview": "node scripts/serve.mjs --built",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:preferences": "node scripts/preferences.mjs",
    "build:public": "node scripts/bundle.mjs && node scripts/build.mjs --public",
    "bundle:installation": "node scripts/installation-assets.mjs",
    "test:unit-language": "node scripts/unit-language-check.mjs",
    "test:odometry": "node scripts/odometry-check.mjs",
    "test:odometry:native": "node scripts/native-odometry-check.mjs",
    "test:tf": "node scripts/tf-runtime-check.mjs && node scripts/tf-visual-check.mjs && node scripts/tf-learning-check.mjs",
    "test:tf-review": "node scripts/tf-adversarial-runtime.mjs && node scripts/tf-checker-attacks.mjs && node scripts/tf-session-review.mjs",
    "test:odometry:ui": "node scripts/odometry-ui-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
